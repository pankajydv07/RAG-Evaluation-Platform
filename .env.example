# ==========================================
# RAG Platform Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------
# Database & Vector Store (Supabase / Postgres + pgvector)
# ------------------------------------------
# If using local Docker pgvector:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragapp
# If using Supabase directly:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ------------------------------------------
# LLM Providers: Groq & Nebius AI
# ------------------------------------------
# Groq (Fast generation & LLM-as-judge)
GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATOR_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=qwen-qwq-32b
GROQ_FAST_MODEL=llama3-8b-8192

# Nebius AI Token Factory (OpenAI-compatible endpoints)
# Endpoint documentation: https://tokenfactory.nebius.com/endpoints
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_GENERATOR_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_EMBEDDING_MODEL=BAAI/bge-en-v1.5

# ------------------------------------------
# Embedding & Retrieval Settings
# ------------------------------------------
# Options: "local" (sentence-transformers), "nebius" (Nebius Token Factory API)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Reranker (Cross-encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
